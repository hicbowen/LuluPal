<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="luluday.exe"
        Arguments=""
        InstallLocation="C:\Program Files\LuluDay\噜噜日">
    </Installer>
    <PackageInformation
        PackageName="LuluDay"
        PackageDisplayName="噜噜日"
        PublisherName="CN=LuluDay"
        PublisherDisplayName="LuluDay"
        Version="0.1.0.0"
        PackageDescription="A LuluDay application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.luluday"
                Description="A LuluDay application"
                DisplayName="噜噜日"
                ExecutableName="luluday.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>噜噜日</DisplayName>
            <PublisherDisplayName>LuluDay</PublisherDisplayName>
            <Description>A LuluDay application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="luluday.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
