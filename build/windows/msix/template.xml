<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="LuluPal.exe"
        Arguments=""
        InstallLocation="C:\Program Files\LuluPal">
    </Installer>
    <PackageInformation
        PackageName="LuluPal"
        PackageDisplayName="噜噜"
        PublisherName="CN=LuluPal"
        PublisherDisplayName="LuluPal"
        Version="0.1.0.0"
        PackageDescription="桌面上的噜噜伴侣">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.lulupal.desktop"
                Description="桌面上的噜噜伴侣"
                DisplayName="噜噜"
                ExecutableName="LuluPal.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>噜噜</DisplayName>
            <PublisherDisplayName>LuluPal</PublisherDisplayName>
            <Description>桌面上的噜噜伴侣</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="LuluPal.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
